<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>

        <!--
            Tests run against a REAL MySQL database, not sqlite :memory:.

            Two reasons. First, plam_task holds the demo data and
            RefreshDatabase would wipe it, so tests get their own schema.
            Second, engine parity: the unique index on the 512-character
            source_url column behaves differently on sqlite, so testing there
            would prove nothing about what ships.

            Create it once with:
              CREATE DATABASE plam_task_test
                CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="plam_task_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>

        <!--
            The database cache store, not "array" - the version-key
            invalidation in ProductCache exists specifically because the
            database driver has no cache tags, so the tests must exercise that
            driver to prove it works.
        -->
        <env name="CACHE_STORE" value="database"/>

        <!--
            Scraping tests use Http::fake() and must never touch the network.
            Disabling the DNS check lets fixtures use test hostnames that do
            not resolve; every other UrlGuard rule still applies, and the DNS
            rule has its own dedicated tests with a scripted resolver.
        -->
        <env name="SCRAPER_VERIFY_DNS" value="false"/>
        <env name="PROXY_MANAGER_ENABLED" value="false"/>

        <!--
            Pinned off so no test can launch a real browser, and so the suite
            behaves the same whatever a developer has in their local .env.
            The fallback's decision logic is covered with a fake PageFetcher in
            BrowserFallbackTest; BrowserFetcher itself is verified by hand.
        -->
        <env name="SCRAPER_BROWSER_FALLBACK" value="false"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
