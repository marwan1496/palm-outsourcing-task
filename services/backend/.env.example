APP_NAME="Palm Outsourcing Task"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plam_task
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Palm Task - scraping configuration
###############################################################################

# Origin allowed by CORS. The frontend normally calls this API server-to-server
# through its BFF route, where CORS does not apply; this matters only if you
# point a browser straight at the API.
FRONTEND_URL=http://localhost:3000

# --- Scraper ----------------------------------------------------------------
SCRAPER_TIMEOUT=20
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MS=500

# Politeness pause before each request, in milliseconds. Raise this when
# scraping many URLs in one batch.
SCRAPER_DELAY_MS=0

# SSRF protection. Resolves each host and rejects private, loopback and
# link-local addresses. NEVER set this to false outside tests - it is the check
# that stops /api/v1/scrape being used to reach internal infrastructure.
SCRAPER_VERIFY_DNS=true

# --- Go proxy-manager microservice ------------------------------------------
# Disabled by default, so the stack runs with no proxies and no Go service:
# every request simply connects directly.
PROXY_MANAGER_ENABLED=false
PROXY_MANAGER_URL=http://127.0.0.1:8081
PROXY_MANAGER_KEY=

# Sub-second on purpose - this call sits on the hot path of every scrape, and
# going without a proxy beats waiting for one.
PROXY_MANAGER_TIMEOUT=0.5
PROXY_MANAGER_FAILURE_THRESHOLD=3
PROXY_MANAGER_BREAKER_COOLDOWN=60

# --- Product listing cache --------------------------------------------------
# CACHE_STORE above drives this. It is set to "database" so the stack needs
# nothing but MySQL; switch it to "redis" and this all keeps working, because
# invalidation uses a version key rather than cache tags.
PRODUCTS_CACHE_ENABLED=true
PRODUCTS_CACHE_FRESH=30
PRODUCTS_CACHE_STALE=120
PRODUCTS_CACHE_HTTP_MAX_AGE=15
